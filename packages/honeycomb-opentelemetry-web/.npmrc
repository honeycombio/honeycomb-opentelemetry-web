ignore-scripts=true
# Quarantine newly published versions instead of freezing the tree at a fixed
# date. Replaces the `before=2025-09-08` stopgap added in #608 after the
# shai-hulud attack, now that npm ships a relative window (npm/cli#8570).
# Requires npm >= 11.10.0 -- older npm silently ignores unknown config keys,
# which would drop this protection. See DEVELOPING.md.
# NOTE: do not re-add `before`; within one source `before` overrides this.
min-release-age=7
